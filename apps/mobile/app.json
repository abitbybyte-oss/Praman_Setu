{
  "expo": {
    "name": "Praman Setu",
    "slug": "praman-setu",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pramansetu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.pramansetu.fdtc",
      "infoPlist": {
        "NSCameraUsageDescription": "Praman Setu photographs the simulated test kit and the reference colour card to produce a signed evidence record.",
        "NSLocationWhenInUseUsageDescription": "The location where a simulated test was performed is recorded in the signed evidence record."
      }
    },
    "android": {
      "package": "in.pramansetu.fdtc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The location where a simulated test was performed is recorded in the signed evidence record."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "029659f9-1aa8-435f-adcd-2187f4b2bcd6"
      }
    },
    "owner": "bitbybyte"
  }
}
